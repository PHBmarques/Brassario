    usuario ||--o{ token_usuario : "tem"
    usuario ||--o{ batelada : "produz"
    usuario ||--o{ movimentacao_estoque : "registra"
    fornecedor |o--o{ lote_insumo : "fornece"
    insumo ||--o{ lote_insumo : "tem lotes"
    insumo ||--o{ receita_item : "compõe"
    receita ||--o{ receita_item : "tem"
    receita ||--o{ batelada : "gera"
    batelada ||--o{ batelada_consumo : "consome"
    lote_insumo ||--o{ batelada_consumo : "é consumido"
    lote_insumo ||--o{ movimentacao_estoque : "movimenta"
