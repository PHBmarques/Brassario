# Copie este arquivo para .env e troque os valores marcados.
# O arquivo .env NAO deve ir para o Git.

POSTGRES_DB=brassario
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Usuario do banco usado pela API (so le e grava dados; nao altera o esquema).
# As migrations rodam com POSTGRES_USER. Use letras minusculas, numeros e sublinhado.
APP_DB_USER=brassario_app
APP_DB_PASSWORD=troque-esta-senha

PGADMIN_EMAIL=admin@brassario.com
PGADMIN_PASSWORD=troque-esta-senha

# Minimo de 32 caracteres
JWT_KEY=troque-por-uma-chave-com-32-ou-mais-caracteres
JWT_ISSUER=brassario
JWT_EXPIRES_MINUTES=30

ASPNETCORE_ENVIRONMENT=Development

# E-mails (em desenvolvimento vao para o Mailpit: http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_FROM=no-reply@brassario.local
APP_URL_FRONT=http://localhost:3000
